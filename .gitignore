# ---------------------------------------------------------------------------
# Pinned third-party payload: recreated by the pinned fetchers, never committed
#   scripts/clone-openvino.sh   -> vendor/openvino-2020.3.2/            (172 MB)
#   scripts/fetch-runtime.sh    -> vendor/reference-runtime/, vendor/firmware/,
#                                  vendor/openvino-2020.3.2-runtime-raspbian.tgz
#   scripts/prepare-deps.sh     -> vendor/deps/
#   scripts/prepare-mobilenet.sh-> vendor/models/  (ONNX + IR + photos, 57 MB)
# ---------------------------------------------------------------------------
vendor/

# Scratch: reference-check images/outputs, staged Model Optimizer tree, the
# extracted host runtime (regenerate with scripts/pull-runtime.sh), test blobs
work/
examples/accuracy-test/images/

# Local Python virtualenvs.  The supported host venv lives under work/
# (work/venv-cpu, already ignored above); a venv created anywhere else - e.g.
# examples/webcam/venv - is the same kind of scratch and must not be committed.
venv/
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Model Optimizer / conversion by-products (the IR itself lives in vendor/, ignored)
*.mapping

# New build/output logs (the tracked logs/*.log evidence files stay committed;
# .gitignore does not untrack them)
logs/*.log
logs/*/*.log

# Editor / OS noise
*.swp
*~
.DS_Store

# Host config files accidentally placed in the repo root
.bash_profile
.bashrc
.env
.gitconfig
.mcp.json
.profile
.ripgreprc
.zprofile
.zshrc
