{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speech-asr/acceptance-policy-v1.schema.json",
  "title": "Speech ASR experiment acceptance policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","required_gates","thresholds","retry_policy"],
  "properties": {
    "schema":{"const":"speech-asr/acceptance-policy"},
    "version":{"const":1},
    "required_gates":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["training","onnx_export","openvino_conversion","myriad_execution","accuracy_evaluation"]}
    },
    "thresholds":{
      "type":"object","additionalProperties":false,
      "properties":{
        "max_wer":{"type":["number","null"],"minimum":0},
        "max_cer":{"type":["number","null"],"minimum":0},
        "max_realtime_factor":{"type":["number","null"],"minimum":0},
        "max_latency_p95_ms":{"type":["number","null"],"minimum":0},
        "min_frame_argmax_agreement":{"type":["number","null"],"minimum":0,"maximum":1}
      }
    },
    "retry_policy":{
      "type":"object","additionalProperties":false,
      "required":["max_attempts","retryable_failure_classes"],
      "properties":{
        "max_attempts":{"type":"integer","minimum":1},
        "retryable_failure_classes":{
          "type":"array","uniqueItems":true,
          "items":{"enum":["transport_preflight","worker_busy","hardware_transient"]}
        }
      }
    }
  }
}
