{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speech-asr/acoustic-regression-result-v1.schema.json",
  "title": "Speech ASR acoustic regression result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "model",
    "fixture",
    "runtime",
    "metrics",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "speech-asr/acoustic-regression-result"
    },
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "family",
        "xml_sha256",
        "bin_sha256"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "xml_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bin_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fixture": {
      "type": "object",
      "required": [
        "features_sha256",
        "reference_scores_sha256"
      ],
      "additionalProperties": true,
      "properties": {
        "features_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_scores_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "repo_commit",
        "backend",
        "target",
        "openvino_version"
      ],
      "additionalProperties": true,
      "properties": {
        "repo_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "backend": {
          "enum": [
            "CPU",
            "MYRIAD"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "openvino_version": {
          "const": "2020.3.2"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "CPU"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "const": "amd64"
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "required": [
        "utterances",
        "total_frames",
        "weighted_mean_infer_ms_per_frame",
        "utterance_avg_infer_ms_per_frame_p50",
        "utterance_avg_infer_ms_per_frame_p95",
        "max_error_max",
        "avg_error_mean",
        "rms_error_mean",
        "failures"
      ],
      "additionalProperties": true,
      "properties": {
        "utterances": {
          "type": "integer",
          "minimum": 0
        },
        "total_frames": {
          "type": "integer",
          "minimum": 0
        },
        "weighted_mean_infer_ms_per_frame": {
          "type": "number",
          "minimum": 0
        },
        "utterance_avg_infer_ms_per_frame_p50": {
          "type": "number",
          "minimum": 0
        },
        "utterance_avg_infer_ms_per_frame_p95": {
          "type": "number",
          "minimum": 0
        },
        "max_error_max": {
          "type": "number",
          "minimum": 0
        },
        "avg_error_mean": {
          "type": "number",
          "minimum": 0
        },
        "rms_error_mean": {
          "type": "number",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "raw_log_sha256"
      ],
      "additionalProperties": true,
      "properties": {
        "raw_log_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
