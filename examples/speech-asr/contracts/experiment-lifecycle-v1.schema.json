{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speech-asr/experiment-lifecycle-v1.schema.json",
  "title": "Speech ASR experiment lifecycle v1",
  "$defs": {
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "git_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "experiment_id":{"type":"string","pattern":"^exp-[0-9a-f]{16}$"},
    "attempt_id":{"type":"string","pattern":"^attempt-[0-9]{4}$"},
    "artifact_ref":{
      "type":"object","additionalProperties":false,
      "required":["path","sha256"],
      "properties":{
        "path":{"type":"string","minLength":1},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "document_ref":{
      "allOf":[{"$ref":"#/$defs/artifact_ref"}]
    },
    "request":{
      "type":"object","additionalProperties":false,
      "required":["schema","version","experiment_id","parent_experiment_id","identity_sha256","source","benchmark","documents","state"],
      "properties":{
        "schema":{"const":"speech-asr/experiment-request"},
        "version":{"const":1},
        "experiment_id":{"$ref":"#/$defs/experiment_id"},
        "parent_experiment_id":{"anyOf":[{"$ref":"#/$defs/experiment_id"},{"type":"null"}]},
        "identity_sha256":{"$ref":"#/$defs/sha256"},
        "state":{"const":"APPROVED"},
        "source":{
          "type":"object","additionalProperties":false,
          "required":["repo_commit"],
          "properties":{"repo_commit":{"$ref":"#/$defs/git_sha"}}
        },
        "benchmark":{
          "type":"object","additionalProperties":false,
          "required":["id","manifest_path","manifest_sha256"],
          "properties":{
            "id":{"type":"string","minLength":1},
            "manifest_path":{"type":"string","minLength":1},
            "manifest_sha256":{"$ref":"#/$defs/sha256"}
          }
        },
        "documents":{
          "type":"object","additionalProperties":false,
          "required":["proposal","model_spec","train_config","acceptance"],
          "properties":{
            "proposal":{"$ref":"#/$defs/document_ref"},
            "model_spec":{"$ref":"#/$defs/document_ref"},
            "train_config":{"$ref":"#/$defs/document_ref"},
            "acceptance":{"$ref":"#/$defs/document_ref"}
          }
        }
      }
    },
    "event":{
      "type":"object","additionalProperties":false,
      "required":["state","at_utc"],
      "properties":{
        "state":{"enum":["APPROVED","EXECUTE","EVALUATE","AWAIT_REVIEW"]},
        "at_utc":{"type":"string","format":"date-time"}
      }
    },
    "attempt":{
      "type":"object","additionalProperties":false,
      "required":["schema","version","experiment_id","attempt_id","attempt_index","request_sha256","state","outcome","events","stage_results"],
      "properties":{
        "schema":{"const":"speech-asr/experiment-attempt"},
        "version":{"const":1},
        "experiment_id":{"$ref":"#/$defs/experiment_id"},
        "attempt_id":{"$ref":"#/$defs/attempt_id"},
        "attempt_index":{"type":"integer","minimum":1,"maximum":9999},
        "request_sha256":{"$ref":"#/$defs/sha256"},
        "state":{"enum":["APPROVED","EXECUTE","EVALUATE","AWAIT_REVIEW"]},
        "outcome":{"enum":["pending","completed","failed","blocked"]},
        "failure_class":{
          "type":["string","null"],
          "enum":[null,"request_config","controller_execution","transport_preflight","worker_busy","hardware_execution","hardware_transient","result_contract"]
        },
        "events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/event"}},
        "stage_results":{
          "type":"object","additionalProperties":false,
          "properties":{
            "training":{"$ref":"#/$defs/artifact_ref"},
            "compatibility":{"$ref":"#/$defs/artifact_ref"},
            "hardware":{"$ref":"#/$defs/artifact_ref"},
            "accuracy":{"$ref":"#/$defs/artifact_ref"},
            "result":{"$ref":"#/$defs/artifact_ref"}
          }
        }
      }
    },
    "summary":{
      "type":"object","additionalProperties":false,
      "required":["schema","version","experiment_id","attempt_id","request_sha256","outcome","review_state","stage_results","artifacts"],
      "properties":{
        "schema":{"const":"speech-asr/experiment-summary"},
        "version":{"const":1},
        "experiment_id":{"$ref":"#/$defs/experiment_id"},
        "attempt_id":{"$ref":"#/$defs/attempt_id"},
        "request_sha256":{"$ref":"#/$defs/sha256"},
        "outcome":{"enum":["completed","failed","blocked"]},
        "review_state":{"const":"AWAIT_REVIEW"},
        "stage_results":{
          "type":"object","additionalProperties":false,
          "properties":{
            "training":{"$ref":"#/$defs/artifact_ref"},
            "compatibility":{"$ref":"#/$defs/artifact_ref"},
            "hardware":{"$ref":"#/$defs/artifact_ref"},
            "accuracy":{"$ref":"#/$defs/artifact_ref"}
          }
        },
        "artifacts":{
          "type":"object","additionalProperties":{"$ref":"#/$defs/artifact_ref"}
        },
        "metrics":{"type":"object","additionalProperties":true},
        "diagnostics":{"type":"object","additionalProperties":true}
      }
    },
    "history_entry":{
      "type":"object","additionalProperties":false,
      "required":["experiment_id","parent_experiment_id","request_sha256","path","latest_attempt_id","latest_outcome"],
      "properties":{
        "experiment_id":{"$ref":"#/$defs/experiment_id"},
        "parent_experiment_id":{"anyOf":[{"$ref":"#/$defs/experiment_id"},{"type":"null"}]},
        "request_sha256":{"$ref":"#/$defs/sha256"},
        "path":{"type":"string","minLength":1},
        "latest_attempt_id":{"anyOf":[{"$ref":"#/$defs/attempt_id"},{"type":"null"}]},
        "latest_outcome":{"enum":[null,"pending","completed","failed","blocked"]}
      }
    },
    "history":{
      "type":"object","additionalProperties":false,
      "required":["schema","version","experiments"],
      "properties":{
        "schema":{"const":"speech-asr/experiment-history"},
        "version":{"const":1},
        "experiments":{"type":"array","items":{"$ref":"#/$defs/history_entry"}}
      }
    }
  },
  "oneOf":[
    {"$ref":"#/$defs/request"},
    {"$ref":"#/$defs/attempt"},
    {"$ref":"#/$defs/summary"},
    {"$ref":"#/$defs/history"}
  ]
}
