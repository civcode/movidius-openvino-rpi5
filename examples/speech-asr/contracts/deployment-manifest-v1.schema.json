{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"speech-asr/deployment-manifest-v1.schema.json",
  "title":"Speech ASR remote deployment manifest v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","version","experiment_id","attempt_id","controller_commit","worker_commit","model","benchmark","runtime","evaluator","artifacts"],
  "properties":{
    "schema":{"const":"speech-asr/deployment-manifest"},
    "version":{"const":1},
    "experiment_id":{"type":"string","pattern":"^exp-[0-9a-f]{16}$"},
    "attempt_id":{"type":"string","pattern":"^attempt-[0-9]{4}$"},
    "controller_commit":{"$ref":"#/$defs/git_sha"},
    "worker_commit":{"$ref":"#/$defs/git_sha"},
    "model":{
      "type":"object","additionalProperties":false,
      "required":["id","spec_sha256"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "spec_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "benchmark":{
      "type":"object","additionalProperties":false,
      "required":["id","manifest_path","manifest_sha256"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "manifest_path":{"type":"string","minLength":1},
        "manifest_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "runtime":{
      "type":"object","additionalProperties":false,
      "required":["target","openvino_version"],
      "properties":{
        "target":{"const":"arm64"},
        "openvino_version":{"const":"2020.3.2"}
      }
    },
    "evaluator":{
      "type":"object","additionalProperties":false,
      "required":["id","result_path"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "result_path":{"type":"string","minLength":1}
      }
    },
    "artifacts":{
      "type":"object","minProperties":2,
      "additionalProperties":{"$ref":"#/$defs/artifact"}
    }
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "git_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["path","sha256"],
      "properties":{
        "path":{"type":"string","minLength":1},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    }
  }
}
