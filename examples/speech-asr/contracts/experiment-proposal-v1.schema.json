{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "speech-asr/experiment-proposal-v1.schema.json",
  "title": "Speech ASR experiment proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","version","title","hypothesis","rationale","changes"],
  "properties": {
    "schema": {"const":"speech-asr/experiment-proposal"},
    "version": {"const":1},
    "title": {"type":"string","minLength":1},
    "hypothesis": {"type":"string","minLength":1},
    "rationale": {"type":"string","minLength":1},
    "changes": {
      "type":"array","minItems":1,
      "items":{"type":"string","minLength":1},
      "uniqueItems":true
    },
    "notes": {"type":"string"}
  }
}
