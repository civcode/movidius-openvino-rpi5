{
  "schema": "speech-asr/custom-model-spec",
  "version": 1,
  "id": "cnn_ctc_v1",
  "family": "cnn_ctc",
  "purpose": "toolchain bring-up skeleton; not an accuracy baseline",
  "frontend": {
    "kind": "logmel-v1",
    "sample_rate_hz": 16000,
    "window_samples": 400,
    "hop_samples": 160,
    "fft_size": 512,
    "mel_bins": 64,
    "fmin_hz": 20,
    "fmax_hz": 7600,
    "log_floor": 0.00001,
    "normalization": "per_mel_bin_mean",
    "fixed_frames": 512,
    "fixed_audio_samples": 82160
  },
  "input_contract": {
    "name": "features",
    "layout": "NCT",
    "dtype": "float32",
    "shape": [
      1,
      64,
      512
    ]
  },
  "network": {
    "channels": [
      48,
      48,
      64
    ],
    "kernels": [
      5,
      5,
      3
    ],
    "strides": [
      1,
      2,
      2
    ],
    "paddings": [
      2,
      2,
      1
    ],
    "activation": "relu",
    "projection_kernel": 1
  },
  "output_contract": {
    "name": "logits",
    "layout": "NTV",
    "dtype": "float32",
    "shape": [
      1,
      128,
      39
    ],
    "semantics": "unnormalized CTC logits"
  },
  "decoder": {
    "kind": "ctc-greedy-v1",
    "blank_index": 0,
    "vocab": "vocab.json"
  },
  "training": {
    "seed": 1337,
    "batch_size": 2,
    "learning_rate": 0.001,
    "epochs": 1,
    "optimizer": "adam",
    "loss": "ctc",
    "zero_infinity": true
  },
  "export": {
    "framework": "pytorch",
    "onnx_opset": 11,
    "fixed_shapes": true,
    "precision": "FP32 source -> FP16 OpenVINO IR"
  },
  "deployment": {
    "target": "MYRIAD",
    "openvino_version": "2020.3.2",
    "precision": "FP16"
  }
}
