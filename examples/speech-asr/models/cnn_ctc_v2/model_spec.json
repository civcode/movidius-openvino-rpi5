{
  "schema": "speech-asr/custom-model-spec",
  "version": 1,
  "id": "cnn_ctc_v2",
  "family": "cnn_ctc",
  "purpose": "Phase 11 generation-1 accuracy/efficiency architecture",
  "frontend": {
    "kind": "logmel-v1",
    "sample_rate_hz": 16000,
    "window_samples": 400,
    "hop_samples": 160,
    "fft_size": 512,
    "mel_bins": 64,
    "fmin_hz": 20,
    "fmax_hz": 7600,
    "log_floor": 0.00001,
    "normalization": "per_mel_bin_mean",
    "fixed_frames": 512,
    "fixed_audio_samples": 82160
  },
  "input_contract": {
    "name": "features",
    "layout": "NCT",
    "dtype": "float32",
    "shape": [1, 64, 512]
  },
  "network": {
    "kind": "residual-temporal-v1",
    "stem": [
      {"channels": 64, "kernel": 5, "stride": 2, "padding": 2},
      {"channels": 96, "kernel": 5, "stride": 2, "padding": 2}
    ],
    "residual_blocks": [
      {"channels": 96, "kernel": 11, "padding": 5, "projection_kernel": 1},
      {"channels": 96, "kernel": 19, "padding": 9, "projection_kernel": 1},
      {"channels": 96, "kernel": 27, "padding": 13, "projection_kernel": 1},
      {"channels": 96, "kernel": 35, "padding": 17, "projection_kernel": 1},
      {"channels": 96, "kernel": 43, "padding": 21, "projection_kernel": 1}
    ],
    "normalization": "batchnorm",
    "activation": "relu",
    "dropout": 0.1,
    "projection_kernel": 1,
    "estimated_parameters": 1347463,
    "estimated_macs_fixed_input": 174804992,
    "receptive_field_feature_frames": 533
  },
  "output_contract": {
    "name": "logits",
    "layout": "NTV",
    "dtype": "float32",
    "shape": [1, 128, 39],
    "semantics": "unnormalized CTC logits"
  },
  "decoder": {
    "kind": "ctc-greedy-v1",
    "blank_index": 0,
    "vocab": "vocab.json"
  },
  "training": {
    "seed": 1337,
    "batch_size": 2,
    "learning_rate": 0.001,
    "epochs": 1,
    "optimizer": "adam",
    "loss": "ctc",
    "zero_infinity": true
  },
  "export": {
    "framework": "pytorch",
    "onnx_opset": 11,
    "fixed_shapes": true,
    "precision": "FP32 source -> FP16 OpenVINO IR"
  },
  "deployment": {
    "target": "MYRIAD",
    "openvino_version": "2020.3.2",
    "precision": "FP16"
  }
}
