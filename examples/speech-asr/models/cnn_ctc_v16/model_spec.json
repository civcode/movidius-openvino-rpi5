{
  "schema": "speech-asr/custom-model-spec",
  "version": 1,
  "id": "cnn_ctc_v16",
  "family": "cnn_ctc",
  "purpose": "model-quality-v4 QuartzNet-15x5 architecture adaptation: published 15x5 time-channel separable CTC encoder with fixed project frontend/output vocabulary",
  "frontend": {
    "kind": "logmel-v1",
    "sample_rate_hz": 16000,
    "window_samples": 400,
    "hop_samples": 160,
    "fft_size": 512,
    "mel_bins": 64,
    "fmin_hz": 20,
    "fmax_hz": 7600,
    "log_floor": 0.00001,
    "normalization": "per_mel_bin_mean",
    "fixed_frames": 512,
    "fixed_audio_samples": 82160
  },
  "input_contract": {
    "name": "features",
    "layout": "NCT",
    "dtype": "float32",
    "shape": [
      1,
      64,
      512
    ]
  },
  "network": {
    "kind": "quartznet-15x5-v1",
    "source": "QuartzNet-15x5 / NeMo ConvASREncoder",
    "normalization": "batchnorm",
    "activation": "relu",
    "dropout": 0.2,
    "separable_convolution": "depthwise-pointwise",
    "prologue": {
      "name": "C1",
      "channels": 256,
      "kernel": 33,
      "stride": 2,
      "dilation": 1,
      "padding": 16,
      "separable": true
    },
    "block_groups": [
      {
        "name": "B1",
        "channels": 256,
        "kernel": 33,
        "block_repeats": 3,
        "module_repeats": 5,
        "stride": 1,
        "dilation": 1,
        "padding": 16
      },
      {
        "name": "B2",
        "channels": 256,
        "kernel": 39,
        "block_repeats": 3,
        "module_repeats": 5,
        "stride": 1,
        "dilation": 1,
        "padding": 19
      },
      {
        "name": "B3",
        "channels": 512,
        "kernel": 51,
        "block_repeats": 3,
        "module_repeats": 5,
        "stride": 1,
        "dilation": 1,
        "padding": 25
      },
      {
        "name": "B4",
        "channels": 512,
        "kernel": 63,
        "block_repeats": 3,
        "module_repeats": 5,
        "stride": 1,
        "dilation": 1,
        "padding": 31
      },
      {
        "name": "B5",
        "channels": 512,
        "kernel": 75,
        "block_repeats": 3,
        "module_repeats": 5,
        "stride": 1,
        "dilation": 1,
        "padding": 37
      }
    ],
    "residual_projection": "pointwise-conv-batchnorm",
    "epilogue": [
      {
        "name": "C2",
        "channels": 512,
        "kernel": 87,
        "stride": 1,
        "dilation": 2,
        "padding": 86,
        "separable": true
      },
      {
        "name": "C3",
        "channels": 1024,
        "kernel": 1,
        "stride": 1,
        "dilation": 1,
        "padding": 0,
        "separable": false
      }
    ],
    "projection_kernel": 1,
    "estimated_parameters": 18934631,
    "estimated_macs_fixed_input": 4827463680,
    "receptive_field_feature_frames": 8057
  },
  "output_contract": {
    "name": "logits",
    "layout": "NTV",
    "dtype": "float32",
    "shape": [
      1,
      256,
      39
    ],
    "semantics": "unnormalized CTC logits"
  },
  "decoder": {
    "kind": "ctc-greedy-v1",
    "blank_index": 0,
    "vocab": "vocab.json"
  },
  "training": {
    "seed": 1337,
    "batch_size": 1,
    "learning_rate": 0.0003,
    "epochs": 32,
    "optimizer": "adam",
    "loss": "ctc",
    "zero_infinity": true,
    "gradient_clip_norm": 5,
    "lr_schedule": "cosine",
    "min_learning_rate": 0.00003,
    "checkpoint_selection": "best_validation_loss"
  },
  "export": {
    "framework": "pytorch",
    "onnx_opset": 11,
    "fixed_shapes": true,
    "precision": "FP32 source -> FP16 OpenVINO IR"
  },
  "deployment": {
    "target": "MYRIAD",
    "openvino_version": "2020.3.2",
    "precision": "FP16",
    "split": {
      "vpu": "QuartzNet acoustic model through CTC logits",
      "cpu": "CTC decoding; prefix beam search/language-model stage follows acoustic validation"
    }
  }
}
